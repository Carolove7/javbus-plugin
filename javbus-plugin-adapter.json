{
  "schemaVersion": 1,
  "id": "juji-op147771-adapter",
  "name": "我的剧集库 (自建适配)",
  "enabled": true,
  "baseUrl": "https://<你的worker子域>.workers.dev",
  "search": {
    "method": "GET",
    "url": "/?q={query}&page={page}",
    "responseType": "json",
    "itemsPath": "items",
    "totalPath": "total",
    "pageSize": 20
  },
  "fields": {
    "sourceItemId": "sourceItemId",
    "title": "title",
    "infoHash": "infoHash",
    "magnet": "magnet",
    "humanSize": "humanSize",
    "createdAt": "createdAt",
    "webUrl": "webUrl"
  },
  "defaults": {
    "magnet": "magnet:?xt=urn:btih:{infoHashUpper}"
  },
  "_comment": "baseUrl 改成你的 Cloudflare Worker 地址（或本地 http://<IP>:8787）。搜索走自建适配服务，支持关键词过滤+翻页。无需 detail endpoint，因为列表项已带 magnet/infoHash。"
}
